---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  t,
  getLanguageFromPath,
  getLocalizedPath,
  type Language
} from '@/lib/i18n';
import { Icon } from '@/components/Icon';
import type { IconName } from '@/components/Icon';

const lang = getLanguageFromPath(Astro.url.pathname) as Language;

const sounds = [
  {
    id: 'gentle-rain',
    translationKey: 'gentleRain',
    icon: 'CloudRain' as IconName,
    bgClass: 'bg-blue-100 dark:bg-blue-900/30',
    textClass: 'text-blue-600 dark:text-blue-300',
    defaultVolume: 0.5
  },
  {
    id: 'wind-in-trees',
    translationKey: 'windInTrees',
    icon: 'Trees' as IconName,
    bgClass: 'bg-emerald-100 dark:bg-emerald-900/30',
    textClass: 'text-emerald-600 dark:text-emerald-300',
    defaultVolume: 0.35
  },
  {
    id: 'water-droplets',
    translationKey: 'waterDroplets',
    icon: 'Droplets' as IconName,
    bgClass: 'bg-cyan-100 dark:bg-cyan-900/30',
    textClass: 'text-cyan-600 dark:text-cyan-300',
    defaultVolume: 0.45
  },
  {
    id: 'flowing-river',
    translationKey: 'flowingRiver',
    icon: 'Waves' as IconName,
    bgClass: 'bg-sky-100 dark:bg-sky-900/30',
    textClass: 'text-sky-600 dark:text-sky-300',
    defaultVolume: 0.45
  },
  {
    id: 'ocean-waves',
    translationKey: 'oceanWaves',
    icon: 'Waves' as IconName,
    bgClass: 'bg-indigo-100 dark:bg-indigo-900/30',
    textClass: 'text-indigo-600 dark:text-indigo-300',
    defaultVolume: 0.4
  },
  {
    id: 'forest-birds',
    translationKey: 'forestBirds',
    icon: 'Bird' as IconName,
    bgClass: 'bg-lime-100 dark:bg-lime-900/30',
    textClass: 'text-lime-700 dark:text-lime-300',
    defaultVolume: 0.32
  },
  {
    id: 'rain-on-window',
    translationKey: 'rainOnWindow',
    icon: 'CloudRain' as IconName,
    bgClass: 'bg-slate-100 dark:bg-slate-700/50',
    textClass: 'text-slate-600 dark:text-slate-300',
    defaultVolume: 0.4
  },
  {
    id: 'fireplace',
    translationKey: 'fireplace',
    icon: 'Flame' as IconName,
    bgClass: 'bg-orange-100 dark:bg-orange-900/30',
    textClass: 'text-orange-600 dark:text-orange-300',
    defaultVolume: 0.3
  },
  {
    id: 'pink-noise',
    translationKey: 'pinkNoise',
    icon: 'AudioLines' as IconName,
    bgClass: 'bg-rose-100 dark:bg-rose-900/30',
    textClass: 'text-rose-600 dark:text-rose-300',
    defaultVolume: 0.26
  }
];

const presets = [
  { id: 'rainy-night', translationKey: 'rainyNightFireplace', icon: 'Flame' as IconName },
  { id: 'forest-morning', translationKey: 'forestMorning', icon: 'Bird' as IconName },
  { id: 'deep-masking', translationKey: 'deepMasking', icon: 'AudioLines' as IconName }
];
---

<BaseLayout
  title={t('relax.sounds.title', lang)}
  description={t('relax.sounds.description', lang)}
>
  <div
    id="soundscape-app"
    class="container mx-auto px-4 py-16"
    data-play={t('relax.sounds.play', lang)}
    data-pause={t('relax.sounds.pause', lang)}
    data-loading={t('relax.sounds.loading', lang)}
    data-unavailable={t('relax.sounds.unavailable', lang)}
  >
    <div class="max-w-4xl mx-auto mb-8 animate-fade-in-up">
      <a
        href={getLocalizedPath('/relax/', lang)}
        class="inline-flex items-center text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors mb-6"
      >
        <Icon name="ArrowRight" size={20} className="rotate-180 mr-2" />
        {t('common.back', lang)}
      </a>

      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
        {t('relax.sounds.title', lang)}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300">
        {t('relax.sounds.description', lang)}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          {t('relax.sounds.mixHint', lang)}
        </p>
        <button
          id="stop-all-btn"
          type="button"
          disabled
          class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
        >
          {t('relax.sounds.stopAll', lang)}
        </button>
      </div>
      <p id="sound-status" class="sr-only" aria-live="polite"></p>
    </div>

    <section class="max-w-4xl mx-auto mb-8 animate-fade-in-up delay-100" aria-labelledby="presets-title">
      <h2 id="presets-title" class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        {t('relax.sounds.presetsTitle', lang)}
      </h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        {t('relax.sounds.presetsHint', lang)}
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {presets.map((preset) => (
          <button
            type="button"
            class="preset-btn flex items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 text-left text-sm font-medium text-gray-700 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-amber-500"
            data-preset={preset.id}
            aria-pressed="false"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
              <Icon name={preset.icon} size={18} />
            </span>
            {t(`relax.sounds.${preset.translationKey}`, lang)}
          </button>
        ))}
      </div>
    </section>

    <div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto animate-fade-in-up delay-200"
    >
      {
        sounds.map((sound) => (
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all duration-300">
            <div
              class={`w-12 h-12 rounded-xl ${sound.bgClass} flex items-center justify-center mb-4 ${sound.textClass}`}
            >
              <Icon name={sound.icon} size={24} />
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
              {t(`relax.sounds.${sound.translationKey}`, lang)}
            </h3>

            <div class="flex items-center gap-3">
              <button
                class="play-btn w-12 h-12 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 flex items-center justify-center hover:scale-105 active:scale-95 transition-all duration-200"
                data-sound={sound.id}
                data-label={t(`relax.sounds.${sound.translationKey}`, lang)}
                type="button"
                aria-pressed="false"
                aria-label={
                  t('relax.sounds.play', lang) +
                  ' ' +
                  t(`relax.sounds.${sound.translationKey}`, lang)
                }
              >
                <Icon name="Play" size={20} className="ml-1" />
              </button>
              <div class="flex-1">
                <input
                  type="range"
                  min="0"
                  max="1"
                  step="0.01"
                  value={sound.defaultVolume}
                  class="volume-slider w-full accent-gray-900 dark:accent-white"
                  data-sound={sound.id}
                  data-default-volume={sound.defaultVolume}
                  aria-label={`${t('relax.sounds.volume', lang)} — ${t(`relax.sounds.${sound.translationKey}`, lang)}`}
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="max-w-4xl mx-auto mt-12 bg-blue-50 dark:bg-blue-900/20 rounded-xl p-6 text-sm text-blue-800 dark:text-blue-200 animate-fade-in-up delay-200"
    >
      <div class="flex gap-3">
        <Icon name="WifiOff" size={20} className="shrink-0" />
        <p set:html={t('relax.sounds.offlineNote', lang)} />
      </div>
      <p class="mt-3 pl-8 text-blue-700/80 dark:text-blue-200/80">
        {t('relax.sounds.volumeSafety', lang)}
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import { Howl } from 'howler';

  type SoundId =
    | 'gentle-rain'
    | 'wind-in-trees'
    | 'water-droplets'
    | 'flowing-river'
    | 'ocean-waves'
    | 'forest-birds'
    | 'rain-on-window'
    | 'fireplace'
    | 'pink-noise';

  type PresetId = 'rainy-night' | 'forest-morning' | 'deep-masking';

  interface Track {
    howl: Howl;
    playbackId: number | null;
    active: boolean;
    fadeTimer: number | null;
    targetVolume: number;
  }

  const soundSources: Record<SoundId, string[]> = {
    'gentle-rain': [
      '/sounds/gentle-rain.webm?v=20260904-2',
      '/sounds/gentle-rain.mp3?v=20260904-2'
    ],
    'wind-in-trees': [
      '/sounds/wind-in-trees.webm?v=20260904-2',
      '/sounds/wind-in-trees.mp3?v=20260904-2'
    ],
    'water-droplets': [
      '/sounds/water-droplets.webm?v=20260904-2',
      '/sounds/water-droplets.mp3?v=20260904-2'
    ],
    'flowing-river': [
      '/sounds/flowing-river.webm?v=20260904-2',
      '/sounds/flowing-river.mp3?v=20260904-2'
    ],
    'ocean-waves': [
      '/sounds/ocean-waves.webm?v=20260904-2',
      '/sounds/ocean-waves.mp3?v=20260904-2'
    ],
    'forest-birds': [
      '/sounds/forest-birds.webm?v=20260904-2',
      '/sounds/forest-birds.mp3?v=20260904-2'
    ],
    'rain-on-window': [
      '/sounds/rain-on-window.webm?v=20260904-2',
      '/sounds/rain-on-window.mp3?v=20260904-2'
    ],
    fireplace: [
      '/sounds/fireplace.webm?v=20260904-2',
      '/sounds/fireplace.mp3?v=20260904-2'
    ],
    'pink-noise': [
      '/sounds/pink-noise.webm?v=20260904-2',
      '/sounds/pink-noise.mp3?v=20260904-2'
    ]
  };

  const presetMixes: Record<PresetId, Partial<Record<SoundId, number>>> = {
    'rainy-night': { 'gentle-rain': 0.42, fireplace: 0.3 },
    'forest-morning': { 'forest-birds': 0.32, 'wind-in-trees': 0.18, 'flowing-river': 0.24 },
    'deep-masking': { 'pink-noise': 0.28, 'gentle-rain': 0.16, 'ocean-waves': 0.12 }
  };

  const app = document.querySelector<HTMLElement>('#soundscape-app');
  const playText = app?.dataset.play || 'Play';
  const pauseText = app?.dataset.pause || 'Pause';
  const loadingText = app?.dataset.loading || 'Loading';
  const unavailableText = app?.dataset.unavailable || 'Audio unavailable';
  const tracks = new Map<SoundId, Track>();
  const buttons = document.querySelectorAll('.play-btn');
  const sliders = document.querySelectorAll('.volume-slider');
  const presetButtons = document.querySelectorAll<HTMLButtonElement>('.preset-btn');
  const stopAllButton = document.querySelector<HTMLButtonElement>('#stop-all-btn');
  const status = document.querySelector<HTMLElement>('#sound-status');

  // SVG for icons
  const PLAY_ICON =
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="ml-1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>';
  const PAUSE_ICON =
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>';

  function isSoundId(value: string | undefined): value is SoundId {
    return Boolean(value && value in soundSources);
  }

  function isPresetId(value: string | undefined): value is PresetId {
    return Boolean(value && value in presetMixes);
  }

  function setActivePreset(id: PresetId | null) {
    presetButtons.forEach((button) => {
      const active = button.dataset.preset === id;
      button.ariaPressed = String(active);
      button.classList.toggle('border-amber-400', active);
      button.classList.toggle('bg-amber-50', active);
      button.classList.toggle('dark:border-amber-500', active);
      button.classList.toggle('dark:bg-amber-900/20', active);
    });
  }

  function resetVolumes() {
    sliders.forEach((slider) => {
      const input = slider as HTMLInputElement;
      const id = input.dataset.sound;
      if (!isSoundId(id)) return;
      const defaultVolume = Number(input.dataset.defaultVolume || 0.5);
      input.value = String(defaultVolume);
      const track = tracks.get(id);
      if (track) track.targetVolume = defaultVolume;
    });
  }

  function sliderFor(id: SoundId) {
    return document.querySelector<HTMLInputElement>(
      `.volume-slider[data-sound="${id}"]`
    );
  }

  function buttonFor(id: SoundId) {
    return document.querySelector<HTMLButtonElement>(
      `.play-btn[data-sound="${id}"]`
    );
  }

  function setButtonState(id: SoundId, active: boolean, loading = false) {
    const button = buttonFor(id);
    if (!button) return;

    const label = button.dataset.label || '';
    button.innerHTML = active ? PAUSE_ICON : PLAY_ICON;
    button.ariaPressed = String(active);
    button.ariaBusy = String(loading);
    button.ariaLabel = `${active ? pauseText : playText} ${label}`;
    button.classList.toggle('bg-amber-500', active);
    button.classList.toggle('dark:bg-amber-400', active);
    button.classList.toggle('animate-pulse', loading);
    button.classList.toggle('bg-gray-900', !active);
    button.classList.toggle('dark:bg-white', !active);
    button.classList.toggle('dark:text-gray-900', !active);
    stopAllButton!.disabled = ![...tracks.values()].some((track) => track.active);
  }

  function getTrack(id: SoundId): Track {
    const existing = tracks.get(id);
    if (existing) return existing;

    let track: Track;
    track = {
      howl: new Howl({
        src: soundSources[id],
        format: ['webm', 'mp3'],
        loop: true,
        preload: false,
        volume: 0,
        onload: () => {
          setButtonState(id, track.active, false);
          if (status) status.textContent = '';
        },
        onplay: (playbackId) => {
          track.playbackId = playbackId;
          if (!track.active) {
            track.howl.pause(playbackId);
            return;
          }
          track.howl.volume(0, playbackId);
          track.howl.fade(0, track.targetVolume, 700, playbackId);
        },
        onloaderror: () => {
          stopTrack(id, true);
          if (status) status.textContent = `${unavailableText}: ${buttonFor(id)?.dataset.label || id}`;
        },
        onplayerror: () => {
          stopTrack(id, true);
          if (status) status.textContent = `${unavailableText}: ${buttonFor(id)?.dataset.label || id}`;
        }
      }),
      playbackId: null,
      active: false,
      fadeTimer: null,
      targetVolume: Number(sliderFor(id)?.value || 0.5)
    };

    tracks.set(id, track);
    return track;
  }

  function startTrack(id: SoundId) {
    const track = getTrack(id);
    if (track.fadeTimer !== null) {
      window.clearTimeout(track.fadeTimer);
      track.fadeTimer = null;
    }

    track.targetVolume = Number(sliderFor(id)?.value || 0.5);
    track.active = true;
    setButtonState(id, true, track.howl.state() !== 'loaded');
    if (status && track.howl.state() !== 'loaded') {
      status.textContent = `${loadingText}: ${buttonFor(id)?.dataset.label || id}`;
    }

    if (track.howl.state() === 'unloaded') track.howl.load();
    if (track.playbackId === null || !track.howl.playing(track.playbackId)) {
      track.playbackId = track.howl.play(track.playbackId ?? undefined);
    }
  }

  function stopTrack(id: SoundId, immediately = false) {
    const track = tracks.get(id);
    if (!track) return;
    if (track.fadeTimer !== null) window.clearTimeout(track.fadeTimer);

    track.active = false;
    setButtonState(id, false);
    if (track.playbackId === null) return;

    const playbackId = track.playbackId;
    const currentVolume = track.howl.volume(playbackId) as number;
    if (immediately || !track.howl.playing(playbackId)) {
      track.howl.pause(playbackId);
      return;
    }

    track.howl.fade(currentVolume, 0, 400, playbackId);
    track.fadeTimer = window.setTimeout(() => {
      if (!track.active) track.howl.pause(playbackId);
      track.fadeTimer = null;
    }, 420);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      setActivePreset(null);
      const id = (button as HTMLElement).dataset.sound;
      if (!isSoundId(id)) return;
      const track = tracks.get(id);
      if (track?.active) stopTrack(id);
      else startTrack(id);
    });
  });

  sliders.forEach((slider) => {
    slider.addEventListener('input', (e) => {
      setActivePreset(null);
      const id = (e.target as HTMLElement).dataset.sound;
      if (!isSoundId(id)) return;
      const track = tracks.get(id);
      const volume = Number((e.target as HTMLInputElement).value);
      if (track) track.targetVolume = volume;
      if (track?.active && track.playbackId !== null) {
        track.howl.volume(volume, track.playbackId);
      }
    });
  });

  presetButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const presetId = button.dataset.preset;
      if (!isPresetId(presetId)) return;

      if (button.ariaPressed === 'true') {
        setActivePreset(null);
        resetVolumes();
        tracks.forEach((_track, id) => stopTrack(id));
        return;
      }

      const mix = presetMixes[presetId];
      (Object.keys(soundSources) as SoundId[]).forEach((id) => {
        const volume = mix[id];
        if (volume === undefined) {
          stopTrack(id);
          return;
        }

        const slider = sliderFor(id);
        if (slider) slider.value = String(volume);
        const track = tracks.get(id);
        if (track?.active && track.playbackId !== null) {
          track.targetVolume = volume;
          track.howl.volume(volume, track.playbackId);
        } else {
          startTrack(id);
        }
      });
      setActivePreset(presetId);
    });
  });

  stopAllButton?.addEventListener('click', () => {
    setActivePreset(null);
    tracks.forEach((_track, id) => stopTrack(id));
  });

  window.addEventListener('pagehide', () => {
    tracks.forEach((track) => track.howl.unload());
  });
</script>
