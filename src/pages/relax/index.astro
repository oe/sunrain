---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  t,
  getLocalizedPath,
  getLanguageFromPath,
  type Language
} from '@/lib/i18n';
import { Icon } from '@/components/Icon';
import { getPlatformCopy } from '@/lib/platform';

const lang = getLanguageFromPath(Astro.url.pathname) as Language;

const p=getPlatformCopy(lang);
---
<BaseLayout title={t('relax.title',lang)} description={p.relaxIntro}>
  <div class="relax-page">
    <header class="page-heading"><h1>{t('relax.title',lang)}</h1><p>{p.relaxIntro}</p></header>
    <div class="relax-destinations">
      <a class="relax-destination" href={getLocalizedPath('/breathing/',lang)}>
        <Icon name="Wind" size={36} /><h2>{t('relax.breathing.title',lang)}</h2>
        <p>{p.breathingHint}</p><span class="platform-link">{t('breathing.start',lang)}<Icon name="ArrowRight" size={21} className="directional" /></span>
      </a>
      <a class="relax-destination" href={getLocalizedPath('/relax/sounds/',lang)}>
        <Icon name="Music" size={36} /><h2>{t('relax.sounds.title',lang)}</h2>
        <p>{t('relax.sounds.description',lang)}</p><span class="platform-link">{t('relax.sounds.play',lang)}<Icon name="ArrowRight" size={21} className="directional" /></span>
      </a>
    </div>
  </div>
</BaseLayout>
