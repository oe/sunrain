---
import ExternalLinkIcon from '@/components/ExternalLinkIcon.astro';
import SupportLayout from '@/layouts/SupportLayout.astro';
import { getLanguageFromPath,t,getLocalizedPath } from '@/lib/i18n';
import { getSupportCopy } from '@/lib/support';
import { getPlatformCopy } from '@/lib/platform';
const lang=getLanguageFromPath(Astro.url.pathname);
const c=getSupportCopy(lang);
const p=getPlatformCopy(lang);
---
<SupportLayout title={t('nav.crisis',lang)}>
  <h1>{t('nav.crisis',lang)}</h1>
  <section class="urgent"><p>{c.common.urgent}</p></section>
  <section class="support-card"><h2>{c.ui.crisisDirectory}</h2><p>{c.ui.crisisNotice}</p><a class="button primary" href="https://findahelpline.com/" target="_blank" rel="noreferrer">{p.crisisAction}<ExternalLinkIcon /></a><p class="muted">Find A Helpline</p></section>
  <details><summary>{c.flow.linkProblem}</summary><p id="crisis-fallback">{c.flow.crisisFallback}</p><p>{c.ui.external}</p></details>
  <section class="support-card"><p>{c.flow.crisisSeparate}</p><a class="button" href={getLocalizedPath('/support/',lang)}>{c.ui.support}</a></section>
</SupportLayout>
