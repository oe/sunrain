---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t,getLocalizedPath,getLanguageFromPath } from '@/lib/i18n';
import { getSupportCopy } from '@/lib/support';
import '@/styles/support.css';
const lang=getLanguageFromPath(Astro.url.pathname);
const c=getSupportCopy(lang);
---
<BaseLayout title={t('home.hero.title',lang)}>
  <section class="bg-gradient-to-br from-amber-50 via-orange-50 to-rose-50 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900">
    <div class="support-shell text-center py-20">
      <img src="/logo.png" alt="" width="80" height="80" class="mx-auto mb-8" />
      <p class="muted">{t('site.tagline',lang)}</p>
      <h1>{t('home.hero.title',lang)}</h1><p>{c.entry.description}</p>
      <div class="actions justify-center"><a class="button primary" id="home-check-in" href={getLocalizedPath('/check-in/',lang)}>{c.entry.title}</a><a class="button" href={getLocalizedPath('/support/',lang)}>{c.ui.support}</a></div>
      <p class="muted">{c.disclaimer.scope}</p>
      <a href={getLocalizedPath('/crisis/',lang)}>{t('nav.crisis',lang)}</a>
    </div>
  </section>
  <section class="support-shell">
    <div class="support-grid">
      <article class="support-card"><h2>{c.ui.selfHelp}</h2><p>{c.common.before}</p><a class="button" href={getLocalizedPath('/self-help/',lang)}>{c.ui.selfHelp}</a></article>
      <article class="support-card"><h2>{t('nav.relax',lang)}</h2><p>{t('home.features.breathing.description',lang)}</p><div class="actions"><a class="button" href={getLocalizedPath('/breathing/',lang)}>{t('home.hero.tryBreathing',lang)}</a><a class="button" href={getLocalizedPath('/relax/',lang)}>{t('nav.relax',lang)}</a></div></article>
      <article class="support-card"><h2>{c.ui.support}</h2><p>{c.seekHelp.provider}</p><a class="button" href={getLocalizedPath('/support/',lang)}>{c.seekHelp.title}</a></article>
    </div>
    <section class="support-card"><h2>{t('home.privacy.title',lang)}</h2><p>{t('home.privacy.description',lang)}</p><a href={getLocalizedPath('/disclaimer/',lang)}>{c.ui.disclaimer}</a></section>
  </section>
</BaseLayout>
