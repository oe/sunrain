---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Icon } from '@/components/Icon';
import { getLocalizedPath,getLanguageFromPath } from '@/lib/i18n';
import { getPlatformCopy } from '@/lib/platform';
const lang=getLanguageFromPath(Astro.url.pathname);
const p=getPlatformCopy(lang);
const introduction=lang.startsWith('zh-') ? p.description.replace('，提供','，\n提供').split('\n') : [p.description];
---
<BaseLayout title={p.headline.join(' ')} description={p.description}>
  <section class="platform-hero" aria-labelledby="home-title">
    <picture class="hero-art" aria-hidden="true">
      <source type="image/avif" srcset="/images/platform/sunrain-hero-800.avif 800w, /images/platform/sunrain-hero-1200.avif 1200w, /images/platform/sunrain-hero-1600.avif 1600w" sizes="100vw" />
      <source type="image/webp" srcset="/images/platform/sunrain-hero-800.webp 800w, /images/platform/sunrain-hero-1200.webp 1200w, /images/platform/sunrain-hero-1600.webp 1600w" sizes="100vw" />
      <img src="/images/platform/sunrain-hero-1600.webp" width="1600" height="850" alt="" fetchpriority="high" />
    </picture>
    <div class="platform-container hero-content">
      <div class="hero-copy">
        <h1 id="home-title">{p.headline.map(line => <span>{line}</span>)}</h1>
        <p class="hero-description">{introduction.map(line=><span>{line}</span>)}</p>
        <a class="platform-button primary" id="home-check-in" href={getLocalizedPath('/check-in/',lang)}>{p.start}<Icon name="ArrowRight" size={23} className="directional" /></a>
        <p class="hero-boundary">{p.homeBoundary}</p>
      </div>
    </div>
  </section>
  <section class="platform-container home-paths" aria-label={p.selfHelp}>
    <article>
      <h2>{p.selfHelp}</h2><p>{p.selfHelpDescription}</p>
      <a class="platform-link" href={getLocalizedPath('/self-help/',lang)}>{p.explore}<Icon name="ArrowRight" size={21} className="directional" /></a>
    </article>
    <article>
      <h2>{p.support}</h2><p>{p.supportDescription}</p>
      <a class="platform-link" href={getLocalizedPath('/support/',lang)}>{p.supportAction}<Icon name="ArrowRight" size={21} className="directional" /></a>
    </article>
  </section>
</BaseLayout>
