---
import SupportLayout from '@/layouts/SupportLayout.astro';
import { getLanguageFromPath,getLocalizedPath } from '@/lib/i18n';
import { getSupportCopy } from '@/lib/support';
import registry from '@/data/screening-registry.json';
// Kept as explicit routes for existing bookmarks. Unverified forms and translations
// are never serialized into the published HTML or client bundles.
export function getStaticPaths(){return ['phq-9','gad-7'].map(id=>({params:{id}}));}
const lang=getLanguageFromPath(Astro.url.pathname);
const c=getSupportCopy(lang);
const tool=registry.tools[Astro.params.id];
---
<SupportLayout title={c.ui.checkIn}>
  <h1>{c.ui.checkIn}</h1>
  <div class="support-card" data-screening-status="unavailable"><p>{c.ui.toolsPending}</p><a href={tool.source} rel="noreferrer" target="_blank">{Astro.params.id.toUpperCase()} · {c.ui.sources}</a></div>
  <div class="actions"><a class="button primary" href={getLocalizedPath('/check-in/',lang)}>{c.entry.title}</a><a class="button" href={getLocalizedPath('/self-help/',lang)}>{c.ui.selfHelp}</a><a class="button" href={getLocalizedPath('/support/',lang)}>{c.ui.support}</a></div>
</SupportLayout>
