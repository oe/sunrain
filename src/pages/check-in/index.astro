---
import SupportLayout from '@/layouts/SupportLayout.astro';
import ContentSources from '@/components/ContentSources.astro';
import HelpPreparation from '@/components/HelpPreparation.astro';
import GuidedActivity from '@/components/GuidedActivity.astro';
import ScreeningFlow from '@/components/ScreeningFlow.astro';
import {getScreeningContent} from '@/lib/screening-content';
import { getLanguageFromPath, getLocalizedPath } from '@/lib/i18n';
import { getSupportCopy } from '@/lib/support';
import { getPlatformCopy } from '@/lib/platform';
const lang = getLanguageFromPath(Astro.url.pathname);
const c = getSupportCopy(lang);
const p = getPlatformCopy(lang);
const {copy:s} = getScreeningContent(lang);
const concerns = ['mood','worry','sleep','energy','other'] as const;
const durations = ['recent','weeks','months','unsure'] as const;
const impacts = ['manageable','disruptive','basicNeeds'] as const;
---
<SupportLayout title={c.entry.title}>
  <h1>{p.start}</h1>
  <p class="muted flow-privacy">{p.privacy}</p>
  <div class="support-card" id="check-in-app" data-step-label={c.flow.step} data-energy-label={c.ui.energy} data-function-label={c.ui.basicNeeds} data-labels={JSON.stringify({ concerns:c.ui.concerns,duration:c.ui.duration,impact:c.ui.impact,skip:c.ui.skip,step:c.flow.step,result:c.ui.result,actionReason:c.flow.actionReason,recordTruncated:c.flow.recordTruncated })}>
    <ScreeningFlow />
    <form id="check-in-form" autocomplete="off">
      <section data-step="0">
        <h2 tabindex="-1">{s.general}</h2>
        <p>{p.boundary}</p>
        <div class="actions"><button class="button primary" id="start-screening" type="button" hidden>{s.begin}</button><button class="button" data-forward type="button" hidden>{s.general}</button></div>
        <p class="muted" data-youth-support>{c.ui.younger}</p>
        <details><summary>{p.details}</summary><p>{s.coverage}</p><p>{s.intro}</p></details>
      </section>
      <section data-step="1" hidden>
        <fieldset><legend tabindex="-1"><span class="step-label" data-progress>{c.flow.step.replace('{current}','1').replace('{total}','2')}</span>{c.ui.concerns}</legend>
          <p class="muted">{c.flow.multiple}</p>
          {concerns.map(key => <label class="choice"><input type="checkbox" name="concern" value={key} data-label={c.ui[key]} />{c.ui[key]}</label>)}
        </fieldset>
        <div class="actions step-actions"><button class="button" data-back type="button">{c.ui.back}</button><button class="button primary" data-forward type="button">{c.ui.next}</button></div>
        <button class="text-button" data-skip type="button">{c.ui.skip}</button>
      </section>
      <section data-step="2" hidden>
        <fieldset><legend tabindex="-1"><span class="step-label" data-progress>{c.flow.step.replace('{current}','2').replace('{total}','2')}</span>{c.ui.duration}</legend>
          {durations.map(key => <label class="choice"><input type="radio" name="duration" value={key} data-label={c.ui[key]} />{c.ui[key]}</label>)}
        </fieldset>
        <fieldset><legend>{c.ui.impact}</legend>
          {impacts.map(key => <label class="choice"><input type="radio" name="impact" value={key} data-label={c.ui[key]} />{c.ui[key]}</label>)}
        </fieldset>
        <div class="actions step-actions"><button class="button" data-back type="button">{c.ui.back}</button><button class="button primary" type="submit">{c.ui.finish}</button></div>
        <button class="text-button" data-skip type="button">{c.ui.skip}</button>
      </section>
    </form>
    <section id="check-in-result" hidden>
      <h2 id="result-title" tabindex="-1">{c.ui.result}</h2>
      <p class="muted" id="general-result-scope">{c.flow.scopeShort}</p>
      <aside class="urgent" id="energy-care" hidden><p>{c.ui.energyCare}</p><a class="button primary" href="#prepare-support" data-prepare-support>{c.flow.prepare}</a></aside>
      <aside class="urgent" id="function-care" hidden><p>{c.flow.functionCare}</p><a class="button primary" href="#prepare-support" data-prepare-support>{c.flow.prepare}</a></aside>
      <p id="action-reason">{c.flow.actionReason}</p>
      <div id="result-options" class="support-grid">
        <article class="support-card" data-action="grounding"><h3>{c.guides.grounding.title}</h3><p>{p.grounding}</p><a class="button primary" href={getLocalizedPath('/self-help/grounding/',lang)}>{c.flow.tryActivity}</a></article>
        <article class="support-card" data-action="one-step"><h3>{c.guides.smallStep.title}</h3><p>{p.oneStep}</p><a class="button primary" href={getLocalizedPath('/self-help/one-step/',lang)}>{c.flow.tryActivity}</a></article>
        <article class="support-card" data-action="sleep"><h3>{c.guides.sleepRoutine.title}</h3><p>{p.sleep}</p><a class="button primary" href={getLocalizedPath('/self-help/sleep/',lang)}>{c.flow.tryActivity}</a></article>
        <article class="support-card" data-action="worry"><h3>{c.guides.worryPlan.title}</h3><p>{p.worry}</p><a class="button primary" href={getLocalizedPath('/self-help/worry/',lang)}>{c.flow.tryActivity}</a></article>
        <article class="support-card" data-action="choose"><h3>{c.ui.selfHelp}</h3><p>{p.guidesIntro}</p><a class="button primary" href={getLocalizedPath('/self-help/',lang)}>{c.ui.selfHelp}</a></article>
        <article class="support-card"><h3>{c.seekHelp.title}</h3><p>{c.ui.care}</p><a class="button" href="#prepare-support" data-prepare-support>{c.flow.prepare}</a></article>
      </div>
      <div id="inline-activity" hidden></div>
      {['grounding','one-step','sleep','worry'].map(id=><template data-inline-guide={id}><GuidedActivity id={id} embedded /></template>)}
      <a href={getLocalizedPath('/self-help/',lang)}>{c.ui.selfHelp}</a>
      <details><summary>{c.flow.viewSummary}</summary><p>{c.ui.limits}</p><p id="result-summary" class="result-summary"></p><button class="button" id="revise-check-in" type="button">{c.ui.back}</button></details>
      <HelpPreparation kind="check-in-appointment" />
    </section>
  </div>
  <ContentSources sources={['selfCare','bipolar','conversation','youthHelp','teenHelp']} />
</SupportLayout>
<script>
  import { initGuidedActivities } from '@/scripts/guided-activity';
  const app = document.querySelector<HTMLElement>('#check-in-app');
  const form = document.querySelector<HTMLFormElement>('#check-in-form');
  const labels = JSON.parse(app.dataset.labels);
  const steps = [...app.querySelectorAll<HTMLElement>('[data-step]')];
  let index = 0;
  let screeningActive = false;
  const preparedScreeningFields=new Map<HTMLTextAreaElement,string>();
  const result = app.querySelector<HTMLElement>('#check-in-result');
  const first = steps[0].querySelector<HTMLButtonElement>('[data-forward]');
  const inlineActivity=document.getElementById('inline-activity');
  function closeActivity(){
    inlineActivity.hidden=true;document.getElementById('result-options').hidden=false;
    const records=document.querySelector<HTMLElement>('[data-screening-record-panel]');if(records)records.hidden=false;
    document.getElementById('result-title').focus({preventScroll:true});
    document.getElementById('result-title').scrollIntoView({block:'start',behavior:'instant'});
  }
  app.querySelectorAll<HTMLAnchorElement>('[data-action] a').forEach(link=>link.addEventListener('click',event=>{
    const id=link.closest<HTMLElement>('[data-action]').dataset.action;
    if(id==='choose')return;
    event.preventDefault();
    if(inlineActivity.dataset.guide!==id){
      const template=app.querySelector<HTMLTemplateElement>(`template[data-inline-guide="${id}"]`);
      inlineActivity.replaceChildren(template.content.cloneNode(true));
      inlineActivity.dataset.guide=id;initGuidedActivities(inlineActivity);
    }
    document.getElementById('result-options').hidden=true;inlineActivity.hidden=false;
    const records=document.querySelector<HTMLElement>('[data-screening-record-panel]');if(records)records.hidden=true;
    const title=inlineActivity.querySelector<HTMLElement>('[data-activity-title]');
    title.focus({preventScroll:true});title.scrollIntoView({block:'start',behavior:'instant'});
  }));
  inlineActivity.addEventListener('click',event=>{if((event.target as Element).closest('[data-activity-close]'))closeActivity();});
  form.reset();
  first.hidden = false;
  function showStep(next: number) {
    screeningActive=false;
    document.querySelectorAll('#screening-results,[data-screening-record-panel]').forEach(el=>el.remove());
    document.getElementById('screening-flow').hidden=true;
    document.getElementById('general-result-scope').hidden=false;
    index = next;
    inlineActivity.replaceChildren();delete inlineActivity.dataset.guide;inlineActivity.hidden=true;
    document.getElementById('result-options').hidden=false;
    result.hidden = true; form.hidden = false;
    steps.forEach((step,i) => step.hidden = i !== index);
    const heading=steps[index].querySelector<HTMLElement>('[tabindex="-1"]');
    heading?.focus({preventScroll:true});
    heading?.scrollIntoView({block:'start',behavior:'instant'});
  }
  app.querySelectorAll('[data-forward]').forEach(button => button.addEventListener('click', () => {
    showStep(Math.min(index+1,2));
  }));
  app.querySelectorAll('[data-back]').forEach(button => button.addEventListener('click', () => showStep(Math.max(0,index-1))));
  app.querySelectorAll('[data-skip]').forEach(button => button.addEventListener('click',()=>{
    steps[index].querySelectorAll<HTMLInputElement>('input').forEach(input=>input.checked=false);
    if(index===1)showStep(2);else form.requestSubmit();
  }));
  let summary = '';
  form.addEventListener('submit', event => {
    event.preventDefault();
    if(index !== 2) return;
    screeningActive=false;
    document.querySelectorAll('#screening-results,[data-screening-record-panel]').forEach(el=>el.remove());
    document.getElementById('general-result-scope').hidden=false;
    document.getElementById('result-title').textContent=labels.result;
    document.getElementById('action-reason').textContent=labels.actionReason;
    const selected = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)];
    summary = ['concern','duration','impact'].map((name,i) => `${[labels.concerns,labels.duration,labels.impact][i]}\n${selected(name).map(v => v.dataset.label).join(' · ') || labels.skip}`).join('\n\n');
    app.querySelector<HTMLElement>('#result-summary').textContent = summary;
    const notes=[...result.querySelectorAll<HTMLTextAreaElement>('#prepare-support [data-note-field]')];
    ['concern','duration','impact'].forEach((name,i)=>{
      notes[i].value=selected(name).map(value=>value.dataset.label).join(' · ');
      preparedScreeningFields.set(notes[i],notes[i].value);
      notes[i].dispatchEvent(new Event('input',{bubbles:true}));
    });
    const needsCare = selected('concern').some(v => v.value === 'energy') || selected('impact').some(v => v.value === 'basicNeeds');
    app.querySelector<HTMLElement>('#energy-care').hidden = !selected('concern').some(v => v.value === 'energy');
    // Offer self-care according to the user's concern; never assign a diagnosis or risk grade.
    const actions={mood:'one-step',worry:'grounding',sleep:'sleep'};
    // One optional starting point keeps the result manageable. This is not a
    // clinical ranking: the user can choose all activities or care directly.
    const firstConcern=selected('concern').find(value=>actions[value.value]);
    const action=firstConcern ? actions[firstConcern.value] : 'choose';
    app.querySelectorAll<HTMLElement>('[data-action]').forEach(card=>card.hidden=needsCare || card.dataset.action!==action);
    app.querySelector<HTMLElement>('#action-reason').hidden=needsCare || !firstConcern;
    app.querySelector<HTMLElement>('#function-care').hidden=!selected('impact').some(v=>v.value==='basicNeeds');
    form.hidden = true; result.hidden = false;
    const title=document.getElementById('result-title');
    title.focus({preventScroll:true});
    title.scrollIntoView({block:'start',behavior:'instant'});
  });
  app.addEventListener('sunrain:general-support',()=>showStep(1));
  app.addEventListener('sunrain:screening-complete',(event:CustomEvent)=>{
    const detail=event.detail;
    screeningActive=true;
    summary=detail.summary;
    document.getElementById('result-summary').textContent=summary;
    document.getElementById('general-result-scope').hidden=true;
    document.getElementById('result-title').textContent=detail.title;
    const fields=[...result.querySelectorAll<HTMLTextAreaElement>('#prepare-support [data-note-field]')];
    // Do not overwrite a person's edits when revising a questionnaire.
    [detail.summary,detail.duration,detail.impact].forEach((value,i)=>{
      if(!fields[i].value||fields[i].value===preparedScreeningFields.get(fields[i])){
        fields[i].value=value.slice(0,2000).replace(/[\uD800-\uDBFF]$/,'');preparedScreeningFields.set(fields[i],fields[i].value);
        if(value.length>2000)document.getElementById('preparation-status').textContent=labels.recordTruncated;
        fields[i].dispatchEvent(new Event('input',{bubbles:true}));
      }
    });
    document.getElementById('energy-care').hidden=!detail.energy;
    document.getElementById('function-care').hidden=!detail.basicNeeds;
    const needsCare=detail.energy||detail.basicNeeds;
    const actions=detail.concerns.map((concern:string)=>({mood:'one-step',worry:'worry'})[concern]);
    app.querySelectorAll<HTMLElement>('[data-action]').forEach(card=>card.hidden=needsCare || !(actions.length?actions.includes(card.dataset.action):card.dataset.action==='choose'));
    document.getElementById('action-reason').hidden=true;
    inlineActivity.replaceChildren();delete inlineActivity.dataset.guide;inlineActivity.hidden=true;
    document.getElementById('result-options').hidden=false;
    form.hidden=true;result.hidden=false;
    const title=document.getElementById('result-title');title.focus({preventScroll:true});title.scrollIntoView({block:'start',behavior:'instant'});
  });
  document.getElementById('revise-check-in').addEventListener('click', () => {
    if(screeningActive)document.getElementById('screening-revise').click();else showStep(1);
  });
  // Back/forward cache must not unexpectedly reveal a previous person's selections.
  window.addEventListener('pageshow', event => { if(event.persisted) { form.reset(); summary=''; preparedScreeningFields.clear(); app.querySelector<HTMLElement>('#result-summary').textContent=''; showStep(0); } });
</script>
