---
import { brandAssets } from '@/lib/branding';
import { t, getLocalizedPath, type Language } from '@/lib/i18n';
import { Icon } from '@/components/Icon';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700"
>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <picture>
          <source srcset={brandAssets.logoAvif} type="image/avif" />
          <img src={brandAssets.logoPng} alt="Sunrain" class="w-8 h-8" />
        </picture>
        <div>
          <p class="font-bold text-gray-900 dark:text-white">Sunrain</p>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {t('footer.mission', lang)}
          </p>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400" data-footer-copyright>
            {t('footer.copyright', lang, { year: currentYear })}
          </p>
        </div>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap justify-center items-center gap-6 text-sm">
        <a href={getLocalizedPath('/understand/',lang)} class="text-gray-600 dark:text-gray-300 hover:underline">{t('nav.understand',lang)}</a>
        <a href={getLocalizedPath('/about/',lang)} class="text-gray-600 dark:text-gray-300 hover:underline">{t('nav.about',lang)}</a>
        <a href={getLocalizedPath('/resources/',lang)} class="text-gray-600 dark:text-gray-300 hover:underline">{t('nav.resources',lang)}</a>
        <a href={getLocalizedPath('/disclaimer/',lang)} class="text-gray-600 dark:text-gray-300 hover:underline">{t('nav.disclaimer',lang)}</a>
        <a href={getLocalizedPath('/support/',lang)} class="text-gray-600 dark:text-gray-300 hover:underline">{t('nav.support',lang)}</a>
        <a
          href={getLocalizedPath('/crisis/', lang)}
          class="flex items-center gap-1 text-red-600 dark:text-red-400 hover:underline font-medium"
        >
          <Icon name="Phone" size={16} />
          {t('nav.crisis', lang)}
        </a>
        <a
          href="https://github.com/oe/sunrain"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
        >
          {t('footer.github', lang)}
        </a>
      </div>
    </div>

  </div>
</footer>
