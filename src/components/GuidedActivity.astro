---
import PrivateNotes from '@/components/PrivateNotes.astro';
import ContentSources from '@/components/ContentSources.astro';
import { getLanguageFromPath,getLocalizedPath } from '@/lib/i18n';
import { getSupportCopy } from '@/lib/support';
import { getPlatformCopy } from '@/lib/platform';
interface Props { id:string; embedded?:boolean; }
const {id,embedded=false}=Astro.props;
const lang=getLanguageFromPath(Astro.url.pathname);
const c=getSupportCopy(lang);
const p=getPlatformCopy(lang);
const guide=({'grounding':c.guides.grounding,'one-step':c.guides.smallStep,'sleep':c.guides.sleepRoutine,'worry':c.guides.worryPlan})[id];
const Title=embedded ? 'h3' : 'h1';
---
<div data-guided-activity>
  <Title data-activity-title tabindex="-1">{guide.title}</Title><p>{({'grounding':p.grounding,'one-step':p.oneStep,'sleep':p.sleep,'worry':p.worry})[id]}</p>
  <p>{c.common.stop}</p>
  {embedded && <div class="actions"><button class="button" type="button" data-activity-close>{c.ui.back}</button></div>}
  <section class="support-card" id="guided-activity" data-step-label={c.flow.step}>
    <p class="muted" id="guide-progress" tabindex="-1" aria-live="polite" hidden></p>
    {id==='one-step'&&<div class="activity-selection-summary" data-activity-selection="current" hidden><p class="activity-selection-label">{c.flow.planLabels[0]}</p><p data-selected-action></p></div>}
    <ol>{guide.steps.map((step,i)=><li data-guide-step tabindex="-1">
      <p>{step}</p>
      {i===0 && <details class="activity-examples"><summary>{c.flow.examples}</summary><fieldset><legend class="sr-only">{c.flow.examples}</legend><p class="muted">{c.flow.exampleHint}</p>{guide.examples.map(example=><label class="choice"><input type="radio" name="activity-example" value={example} />{example}</label>)}</fieldset>{id==='one-step'&&<p class="muted" data-selection-notice role="status" hidden>{p.keepWrittenStep}</p>}</details>}
    </li>)}</ol>
    <div class="actions" id="guide-controls" hidden>
      <button class="button" id="guide-back" type="button">{c.ui.back}</button>
      <button class="button primary" id="guide-next" type="button">{c.flow.guideNext}</button>
      <button class="button primary" id="guide-finish" type="button" hidden>{c.flow.guideFinish}</button>
      <button class="text-button" id="guide-stop" type="button">{c.flow.guideStop}</button>
    </div>
    <p>{guide.takeaway}</p>
  </section>
  <section class="support-card" id="activity-reflection">
    {id==='one-step'&&<div class="activity-selection-summary" data-activity-selection="completion" role="group" aria-label={c.flow.planLabels[0]} tabindex="-1" hidden><p class="activity-selection-label">{c.flow.planLabels[0]}</p><p data-selected-action></p></div>}
    <h2 tabindex="-1">{c.ui.feedback}</h2>
    <fieldset id="activity-feedback"><legend class="sr-only">{c.ui.feedback}</legend>{['better','same','worse'].map(key=><label class="choice"><input type="radio" name="feedback" value={key} />{c.ui[key]}</label>)}</fieldset>
    <p class="muted" id="feedback-intro">{c.flow.guideDone}</p>
    <p id="feedback-better" hidden role="status">{c.flow.feedbackBetter}</p>
    <p id="feedback-same" hidden role="status">{c.common.noChange}</p>
    <p id="feedback-worse" hidden role="status">{c.ui.stop}</p>
    <div class="actions">
      <a class="button" href={getLocalizedPath('/',lang)}>{c.flow.end}</a>
      <a class="button" id="other-activities" href={getLocalizedPath('/self-help/',lang)}>{c.ui.selfHelp}</a>
      <a class="button primary" href="#prepare-support" data-prepare-support>{c.flow.prepare}</a>
    </div>
    <aside class="urgent" id="feedback-urgent" hidden><p>{c.common.urgent}</p><a class="button" href={getLocalizedPath('/crisis/',lang)}>{c.ui.crisisDirectory}</a></aside>
  </section>
  <details data-activity-note class="activity-note"><summary>{p.record}</summary><PrivateNotes kind={embedded ? `check-in-${id}` : id} title={c.flow.planTitle} labels={c.flow.planLabels} /></details>
  <details><summary>{p.guideTips}</summary><p>{guide.purpose}</p></details>
  <ContentSources sources={id==='grounding'?['grounding','selfCare']:id==='worry'?['worries']:id==='sleep'?['selfCare','bipolar']:['selfCare']} />
</div>
<script>
  import { initGuidedActivities } from '@/scripts/guided-activity';
  initGuidedActivities();
</script>
