---
import { brandAssets } from '@/lib/branding';
import {
  getLanguageFromPath,
  isRTL,
  t,
  type Language,
  SUPPORTED_LANGUAGES
} from '@/lib/i18n';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/tailwind.css';
import '@/styles/platform.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description,
  image = brandAssets.shareImage,
  type = 'website'
} = Astro.props;

const pathname = Astro.url.pathname;
const lang = getLanguageFromPath(pathname) as Language;
const dir = isRTL(lang) ? 'rtl' : 'ltr';
// No third-party analytics on pages where people reflect on their health.
const privatePage = /\/(check-in|assessment|support|self-help|crisis|disclaimer)(\/|$)/.test(pathname);
// Topic reading can reveal health interests too; keep it free of telemetry.
const noTelemetry = privatePage || /\/understand(\/|$)/.test(pathname);
const canonicalUrl = new URL(pathname.replace(/^\/en(?=\/|$)/,'') || '/', Astro.site).href;

const siteTitle = title
  ? `${title} | Sunrain`
  : `Sunrain - ${t('site.tagline', lang)}`;
const siteDescription = description || t('site.description', lang);
const siteImage = new URL(image, Astro.site).href;

// Generate alternate language links for SEO
const alternateLinks = SUPPORTED_LANGUAGES.map((locale) => {
  // Handle both simple locales (en, es) and compound locales (zh-hans, zh-hant)
  const cleanPath =
    pathname.replace(/^\/[a-z]{2}(-[a-z]+)?(?=\/|$)/, '') || '/';
  const url =
    locale === 'en'
      ? new URL(cleanPath, Astro.site).href
      : new URL(`/${locale}${cleanPath}`, Astro.site).href;
  return { lang: locale, url };
});
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/png" href={brandAssets.favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>

    <!-- SEO -->
    <meta name="robots" content={privatePage ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Hreflang Links -->
    {
      alternateLinks.map(({ lang: l, url }) => (
        <link rel="alternate" hreflang={l} href={url} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL('/', Astro.site).href}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={siteImage} />
    <meta
      property="og:locale"
      content={lang === 'zh-hans'
        ? 'zh_CN'
        : lang === 'zh-hant'
          ? 'zh_TW'
          : lang}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={siteImage} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Sunrain',
        url: Astro.site,
        description: t('site.description', lang),
        inLanguage: lang
      })}
    />

    <!-- Theme initialization -->
    <script is:inline>
      (function () {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch {}
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;
        const html = document.documentElement;

        html.classList.remove('dark');
        if (
          savedTheme === 'dark' ||
          (savedTheme === 'system' && prefersDark) ||
          (!savedTheme && prefersDark)
        ) {
          html.classList.add('dark');
        }
      })();
    </script>

    <!-- Pass language to client -->
    <script is:inline define:vars={{ lang }}>
      window.__LANG__ = lang;
    </script>
  </head>
  <body
    class="platform min-h-screen bg-white dark:bg-gray-900 flex flex-col font-sans antialiased"
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-gray-900 focus:p-3 focus:rounded-lg">{t('common.skipToContent',lang)}</a>
    <Header lang={lang} />
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- Cloudflare Web Analytics: anonymous page and performance measurements only. -->
    {!noTelemetry && <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "684ad3417be54b9f94e54af82b4169c0"}'
    ></script>}
  </body>
</html>
